# RivalSKU environment variables
# Copy to .env.local for local development:  cp .env.example .env.local

# Public site URL (used in Stripe redirects and alert links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Stripe (required to take payments) ---
# Get these from https://dashboard.stripe.com/apikeys and Products
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_SCALE=price_...

# --- Alerts (optional — the app logs payloads cleanly if these are unset) ---
# Slack incoming webhook: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Resend: https://resend.com/api-keys
RESEND_API_KEY=re_...
ALERT_FROM_EMAIL=RivalSKU <hello@rivalsku.com>
